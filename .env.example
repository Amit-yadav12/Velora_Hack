# Copy to .env for local development. Blank provider values are intentional.
# Never put service-role keys, OAuth secrets, mail keys, or signing secrets in VITE_* variables.

# Optional public origin. Leave blank for local development; set the deployed origin in the hosting environment.
# Browser-visible configuration
VITE_APP_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=
# Optional comma-separated hostnames for a trusted remote dev preview.
# Leave blank for local development; do not use a wildcard.
VITE_DEV_ALLOWED_HOSTS=
# Show one-click demo account buttons only for an isolated cloud demo.
VITE_ENABLE_PUBLIC_DEMO_ACCOUNTS=false

# Server-side application configuration
APP_URL=
SUPABASE_URL=
# Legacy deployments may still use NEXT_PUBLIC_SUPABASE_URL; prefer SUPABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
GOOGLE_MAPS_API_KEY=

# Optional integrations (server-side)
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_RELAY_URL=
EMAIL_FROM=
ADMIN_EMAIL=
QR_SIGNING_SECRET=
CRON_SECRET=

# Optional database-provider restore hook (leave blank for most deployments)
FULLSTACK_PROJECT_REF=
FULLSTACK_RESTORE_API_URL=

# Only set true on a separate, isolated demo deployment with sample data.
# If enabled, set BOTH this server variable and VITE_ENABLE_PUBLIC_DEMO_ACCOUNTS=true.
ENABLE_PUBLIC_DEMO_ACCOUNTS=false
